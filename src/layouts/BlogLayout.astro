---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  author?: string;
  date?: Date;
  category?: string;
  [key: string]: unknown;
}

const { title, description, author, date, category, ...rest } = Astro.props;
---

<BaseLayout title={title} description={description} {...rest}>
  <article class="prose prose-lg mx-auto max-w-4xl py-12">
    <header class="mb-12">
      {title && <h1>{title}</h1>}
      {description && <p class="text-xl text-base-content/70">{description}</p>}

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-base-content/60">
        {author && <span>Por {author}</span>}
        {date && <span>{date.toLocaleDateString('pt-BR')}</span>}
        {category && <span class="badge badge-primary">{category}</span>}
      </div>
    </header>

    <slot />
  </article>
</BaseLayout>
