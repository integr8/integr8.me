---
import BaseLayout from './BaseLayout.astro';
import { Breadcrumb } from '@components/common/Breadcrumb';

export interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  [key: string]: unknown;
}

const { title, description, breadcrumbs, ...rest } = Astro.props;
---

<BaseLayout title={title} description={description} {...rest}>
  <div class="bg-base-50 min-h-screen">
    {
      breadcrumbs && (
        <div class="border-b border-base-200 bg-base-100">
          <div class="container mx-auto px-4 py-4">
            <Breadcrumb items={breadcrumbs} client:load />
          </div>
        </div>
      )
    }
    <div class="container mx-auto px-4 py-12">
      {title && <h1 class="mb-6 text-4xl font-bold">{title}</h1>}
      {description && <p class="mb-8 text-lg text-base-content/70">{description}</p>}
      <slot />
    </div>
  </div>
</BaseLayout>
