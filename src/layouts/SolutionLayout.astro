---
import BaseLayout from './BaseLayout.astro';
import { SolutionHero } from '@components/content/SolutionHero';
import { SolutionTableOfContents } from '@components/content/SolutionTableOfContents';
import { SolutionCTA } from '@components/content/SolutionCTA';

export interface Props {
  title?: string;
  description?: string;
  category?: string;
  technologies?: string[];
  icon?: string;
  lang?: string;
  [key: string]: unknown;
}

const {
  title,
  description,
  category = 'engineering',
  technologies = [],
  icon,
  lang = 'ptbr',
  ...rest
} = Astro.props;

const contactUrl = `/${lang}/contato`;
---

<BaseLayout title={title} description={description} {...rest}>
  <!-- Hero Section -->
  <SolutionHero
    client:load
    title={title || ''}
    description={description || ''}
    category={category}
    technologies={technologies}
    icon={icon}
  />

  <!-- Main Content Area -->
  <div class="relative">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="grid gap-8 lg:grid-cols-[1fr_280px]">
        <!-- Article Content -->
        <article class="solution-content min-w-0">
          <div
            class="prose prose-lg max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-h2:mb-6 prose-h2:mt-16 prose-h2:border-b prose-h2:border-base-200 prose-h2:pb-4 prose-h2:text-3xl prose-h3:mb-4 prose-h3:mt-10 prose-h3:text-xl prose-p:leading-relaxed prose-p:text-base-content/80 prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-ul:my-4 prose-li:text-base-content/80 prose-table:my-8 prose-table:overflow-hidden prose-table:rounded-xl prose-table:border prose-table:border-base-200 prose-th:bg-base-200/50 prose-th:p-4 prose-th:text-left prose-th:font-bold prose-td:border-t prose-td:border-base-200 prose-td:p-4"
          >
            <slot />
          </div>

          <!-- CTA Section -->
          <SolutionCTA
            client:visible
            primaryAction={{ label: 'Fale Conosco', href: contactUrl }}
            secondaryAction={{ label: 'Ver mais soluções', href: `/${lang}/solucoes` }}
          />
        </article>

        <!-- Sidebar with TOC -->
        <SolutionTableOfContents client:load />
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Solution content specific styles */
  .solution-content h2 {
    @apply flex items-center gap-3;
  }

  .solution-content h2::before {
    content: '';
    @apply h-8 w-1 rounded-full bg-gradient-to-b from-primary to-secondary;
  }

  /* Remove prose margins for custom components */
  .solution-content .my-8,
  .solution-content .my-12 {
    @apply !my-8;
  }

  /* Better spacing for feature grids inside prose */
  .solution-content > .prose > div[class*='grid'],
  .solution-content > .prose > div[class*='my-'] {
    @apply !max-w-none;
  }

  /* Ensure cards and grids break out of prose max-width */
  .solution-content .prose > .grid,
  .solution-content .prose > div:not(.prose) {
    @apply !max-w-none;
  }

  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Better table styling */
  .solution-content table {
    @apply w-full;
  }

  .solution-content thead tr {
    @apply border-b-0;
  }

  .solution-content tbody tr:hover {
    @apply bg-base-200/30;
  }

  /* Section dividers */
  .solution-content hr {
    @apply my-16 border-base-200;
  }

  /* Callout improvements */
  .solution-content [class*='bg-info'],
  .solution-content [class*='bg-success'],
  .solution-content [class*='bg-warning'],
  .solution-content [class*='bg-error'] {
    @apply !my-8 !rounded-2xl;
  }
</style>
