---
import BaseLayout from './BaseLayout.astro';
import { Badge } from '@components/common/Badge';

export interface Props {
  title?: string;
  description?: string;
  technologies?: string[];
  [key: string]: unknown;
}

const { title, description, technologies = [], ...rest } = Astro.props;
---

<BaseLayout title={title} description={description} {...rest}>
  <article class="prose prose-lg mx-auto max-w-4xl py-12">
    <header class="mb-12">
      {title && <h1>{title}</h1>}
      {description && <p class="text-xl text-base-content/70">{description}</p>}

      {
        technologies && technologies.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {technologies.map((tech) => (
              <Badge key={tech} variant="primary">
                {tech}
              </Badge>
            ))}
          </div>
        )
      }
    </header>

    <slot />
  </article>
</BaseLayout>
