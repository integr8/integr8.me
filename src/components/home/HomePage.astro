---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Hero } from '@components/home/Hero';
import { Badge } from '@components/common/Badge';
import { Button } from '@components/common/Button';
import { Icon } from '@components/common/Icon';
import { useTranslations } from '@i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);

const allSolutions = await getCollection('solutions');
const solutions = allSolutions.filter((s) => s.id.startsWith(`${lang}/`));
const cases = await getCollection('cases');
const posts = await getCollection('blog');
---

<BaseLayout title="Integr8 - Consultoria Cloud-Native">
  <!-- Hero Section -->
  <Hero
    badge={t('hero.badge')}
    title={t('hero.title')}
    subtitle={t('hero.subtitle')}
    cta={{
      primary: { label: t('hero.cta.primary'), href: `/${lang}/contato` },
      secondary: { label: t('hero.cta.secondary'), href: `/${lang}/solucoes` },
    }}
  />

  <!-- Solutions Grid -->
  <section class="bg-base-50 container mx-auto px-4 py-16">
    <h2 class="mb-4 text-center text-3xl font-bold">{t('solutions.title')}</h2>
    <p class="mx-auto mb-12 max-w-2xl text-center text-base-content/70">
      {t('solutions.subtitle')}
    </p>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        solutions.slice(0, 6).map((solution) => (
          <a
            href={`/${lang}/solucoes/${solution.slug.split('/').pop()}`}
            class="card border border-base-300 bg-base-200/50 shadow-lg transition-all hover:border-primary/30 hover:shadow-xl"
          >
            <div class="card-body items-center text-center">
              <Icon name={solution.data.icon} className="h-12 w-12 text-primary" client:load />
              <h3 class="card-title text-lg text-base-content">{solution.data.title}</h3>
              <p class="text-sm text-base-content/80">{solution.data.description}</p>
              {solution.data.technologies && (
                <div class="mt-4 flex flex-wrap justify-center gap-2">
                  {solution.data.technologies.slice(0, 3).map((tech: string) => (
                    <Badge key={tech} variant="primary">
                      {tech}
                    </Badge>
                  ))}
                </div>
              )}
              <div class="card-actions mt-4">
                <Button variant="primary" size="sm">
                  {t('solutions.learn_more')}
                  <Icon name="ArrowRightIcon" className="h-4 w-4" client:load />
                </Button>
              </div>
            </div>
          </a>
        ))
      }
    </div>
    <div class="mt-12 flex justify-center">
      <a href={`/${lang}/solucoes`}>
        <Button variant="outline" size="lg">
          {t('solutions.view_all')}
        </Button>
      </a>
    </div>
  </section>

  <!-- Cases Section -->
  <section class="container mx-auto px-4 py-16">
    <h2 class="mb-4 text-center text-3xl font-bold">{t('cases.title')}</h2>
    <p class="mx-auto mb-12 max-w-2xl text-center text-base-content/70">
      {t('cases.subtitle')}
    </p>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        cases.slice(0, 4).map((caseItem) => (
          <a
            href={`/${lang}/cases/${caseItem.slug.split('/').pop()}`}
            class="card bg-base-100 shadow-lg transition-shadow hover:shadow-xl"
          >
            <div class="card-body">
              <div class="mb-4 flex items-center gap-2">
                <Icon name="TrophyIcon" className="h-6 w-6 text-warning" client:load />
                {caseItem.data.industry && (
                  <Badge variant="warning">{caseItem.data.industry}</Badge>
                )}
              </div>
              <h3 class="card-title">{caseItem.data.title}</h3>
              <p class="text-sm text-base-content/70">{caseItem.data.challenge}</p>
              <div class="card-actions mt-4 justify-end">
                <Button variant="primary" size="sm">
                  {t('cases.challenge')}
                </Button>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Blog Preview Section -->
  <section class="bg-base-50 container mx-auto px-4 py-16">
    <h2 class="mb-4 text-center text-3xl font-bold">{t('blog.title')}</h2>
    <p class="mx-auto mb-12 max-w-2xl text-center text-base-content/70">
      {t('blog.subtitle')}
    </p>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        posts.slice(0, 3).map((post) => (
          <a
            href={`/${lang}/blog/${post.slug.split('/').pop()}`}
            class="card bg-base-100 shadow-lg transition-shadow hover:shadow-xl"
          >
            {post.data.image && (
              <figure class="h-48 overflow-hidden">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="h-full w-full object-cover"
                  onerror="this.parentElement.style.display='none'"
                />
              </figure>
            )}
            <div class="card-body">
              {post.data.category && <Badge variant="primary">{post.data.category}</Badge>}
              <h3 class="card-title text-lg">{post.data.title}</h3>
              <p class="text-sm text-base-content/70">{post.data.description}</p>
              <div class="mt-4 flex items-center justify-between text-xs text-base-content/60">
                <span>{post.data.author}</span>
                <span>{post.data.read_time} min read</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-primary py-16 text-primary-content">
    <div class="container mx-auto px-4 text-center">
      <h2 class="mb-4 text-3xl font-bold">{t('cta.title')}</h2>
      <p class="mb-8 text-lg opacity-90">{t('cta.subtitle')}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`/${lang}/contato`}>
          <Button variant="primary" size="lg" className="bg-white text-primary hover:bg-base-100">
            {t('cta.primary')}
          </Button>
        </a>
        <a href={`/${lang}/solucoes`}>
          <Button
            variant="ghost"
            size="lg"
            className="border border-white text-white hover:bg-white hover:text-primary"
          >
            {t('cta.secondary')}
          </Button>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
