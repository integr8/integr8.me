---
import { Icon } from '@components/common/Icon';
import { Button } from '@components/common/Button';
import ThemeSwitcherIsland from '@components/common/ThemeSwitcherIsland.astro';
import LanguageSwitcherIsland from '@components/common/LanguageSwitcherIsland.astro';
import { loadNavigation } from '@lib/toml';
import { getCollection } from 'astro:content';

interface Props {
  lang: string;
  translations: Record<string, string>;
}

const { lang, translations } = Astro.props;

interface NavItem {
  key: string;
  href?: string;
  icon: string;
  is_cta?: boolean;
}

const navData = loadNavigation() as { main?: NavItem[] };
const nav = navData.main || [];
const ctaItem = nav.find((item) => item.is_cta);
const mainItems = nav.filter((item) => !item.is_cta);

// Buscar soluções para o dropdown
const allSolutions = await getCollection('solutions');
const solutions = allSolutions.filter((s) => s.id.startsWith(`${lang}/`));

const getNavLabel = (key: string): string => {
  return translations?.nav?.[key] || key;
};

// Get current path to check active state
const currentPath = Astro.url.pathname;

// Check if a nav item is active (current page or subpage)
const isActive = (itemHref: string | undefined): boolean => {
  if (!itemHref) return false;
  const fullPath = `/${lang}${itemHref}`;
  // Match exact path or subpath (e.g., /ptbr/solucoes matches /ptbr/solucoes/platform-engineering)
  return currentPath === fullPath || currentPath.startsWith(fullPath + '/');
};
---

<div class="navbar sticky top-0 z-40 bg-base-100 shadow-lg">
  <div class="navbar-start">
    <div class="dropdown">
      <label tabindex="0" class="btn btn-ghost lg:hidden">
        <Icon name="Bars3Icon" className="h-6 w-6" client:load />
      </label>
      <ul tabindex="0" class="menu dropdown-content z-[1] w-52 rounded-box bg-base-100 p-2 shadow">
        {
          mainItems.map((item) => (
            <li>
              <a
                href={`/${lang}${item.href}`}
                class:list={[isActive(item.href) && 'bg-primary text-primary-content']}
              >
                <Icon name={item.icon} className="h-4 w-4" client:load />
                {getNavLabel(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <a href={`/${lang}/`} class="btn btn-ghost text-xl">
      <img src="/images/logo.png" alt="Integr8" class="h-8 w-auto" />
    </a>
  </div>

  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal gap-2 px-1">
      {
        mainItems.map((item) =>
          item.key === 'solutions' ? (
            <li class="dropdown dropdown-hover">
              <a
                href={`/${lang}${item.href}`}
                tabindex="0"
                role="button"
                class:list={[
                  'rounded-btn px-4',
                  isActive(item.href) &&
                    'bg-primary text-primary-content hover:bg-primary hover:text-primary-content',
                ]}
              >
                <Icon name={item.icon} className="h-4 w-4" client:load />
                {getNavLabel(item.key)}
                <Icon name="ChevronDownIcon" className="h-3 w-3" client:load />
              </a>
              <ul
                tabindex="0"
                class="menu dropdown-content z-[1] grid w-[500px] grid-cols-2 gap-1 rounded-box border border-base-300 bg-base-200 p-4 shadow-lg"
              >
                {solutions.map((solution) => (
                  <li>
                    <a
                      href={`/${lang}/solucoes/${solution.slug.split('/').pop()}`}
                      class="flex items-center gap-2 hover:bg-base-300"
                    >
                      <Icon
                        name={solution.data.icon}
                        className="h-4 w-4 text-primary"
                        client:load
                      />
                      <span class="text-sm">{solution.data.title}</span>
                    </a>
                  </li>
                ))}
                <li class="col-span-2 mt-2 border-t border-base-300 pt-2">
                  <a href={`/${lang}/solucoes`} class="font-medium text-primary hover:bg-base-300">
                    {lang === 'ptbr' ? 'Ver todas as soluções' : 'View all solutions'}
                    <Icon name="ArrowRightIcon" className="h-4 w-4" client:load />
                  </a>
                </li>
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={`/${lang}${item.href}`}
                class:list={[
                  'rounded-btn px-4',
                  isActive(item.href) &&
                    'bg-primary text-primary-content hover:bg-primary hover:text-primary-content',
                ]}
              >
                <Icon name={item.icon} className="h-4 w-4" client:load />
                {getNavLabel(item.key)}
              </a>
            </li>
          )
        )
      }
    </ul>
  </div>

  <div class="navbar-end gap-2">
    <ThemeSwitcherIsland />
    <LanguageSwitcherIsland currentLang={lang} />
    {
      ctaItem && (
        <a href={`/${lang}${ctaItem.href}`} class="hidden sm:inline-block">
          <Button variant="primary" size="sm" className="gap-2">
            <Icon name={ctaItem.icon} className="h-4 w-4" client:load />
            {getNavLabel(ctaItem.key)}
          </Button>
        </a>
      )
    }
  </div>
</div>
