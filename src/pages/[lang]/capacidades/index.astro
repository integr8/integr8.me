---
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadCapabilities } from '@lib/toml';
import { CapabilitiesAccordion } from '@components/content/CapabilitiesAccordion';

export function getStaticPaths() {
  return [{ params: { lang: 'ptbr' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;

// Carregar capabilities do TOML
const capabilities = loadCapabilities();

const certifications = [
  {
    category: 'Kubernetes & CNCF',
    certs: [
      'Kubestronaut (CKA + CKAD + CKS + KCNA + KCSA)',
      'Certified Kubernetes Administrator (CKA)',
      'Certified Kubernetes Application Developer (CKAD)',
      'Certified Kubernetes Security Specialist (CKS)',
    ],
  },
  {
    category: 'Cloud Providers',
    certs: [
      'AWS Solutions Architect Professional',
      'AWS DevOps Engineer Professional',
      'AWS Security Specialty',
      'Azure Solutions Architect Expert',
      'Azure DevOps Engineer Expert',
      'Google Cloud Professional Architect',
    ],
  },
  {
    category: 'Enterprise & Security',
    certs: [
      'Oracle Certified Professional (OCP)',
      'IBM Certified Solution Developer',
      'Certified Ethical Hacker (CEH)',
      'ITIL v4 Foundation & Managing Professional',
    ],
  },
];
---

<BaseLayout
  title={lang === 'ptbr' ? 'Capacidades Técnicas' : 'Technical Capabilities'}
  description={lang === 'ptbr'
    ? 'Expertise profunda em toda a stack de tecnologias cloud-native modernas, de infraestrutura a aplicações.'
    : 'Deep expertise in the entire modern cloud-native technology stack, from infrastructure to applications.'}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-base-200 to-base-100 py-20">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-4xl text-center">
        <span class="text-sm font-semibold uppercase tracking-wide text-primary">
          {lang === 'ptbr' ? 'Expertise' : 'Expertise'}
        </span>
        <h1 class="mb-6 mt-2 text-4xl font-bold md:text-5xl">
          {lang === 'ptbr' ? 'Capacidades Técnicas' : 'Technical Capabilities'}
        </h1>
        <p class="mb-8 text-xl text-base-content/70">
          {
            lang === 'ptbr'
              ? 'Nossa expertise abrange as tecnologias mais relevantes do ecossistema cloud-native. Não apenas conhecemos essas ferramentas—já implantamos, operamos e debugamos em produção em escala.'
              : "Our expertise covers the most relevant technologies in the cloud-native ecosystem. We don't just know these tools—we've deployed, operated, and debugged them in production at scale."
          }
        </p>
      </div>
    </div>
  </section>

  <!-- Why Our Expertise Matters -->
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-3">
        <div class="card bg-base-200">
          <div class="card-body items-center text-center">
            <div class="mb-2 text-4xl">🏭</div>
            <h3 class="card-title text-lg">
              {lang === 'ptbr' ? 'Experiência em Produção' : 'Production Experience'}
            </h3>
            <p class="text-sm text-base-content/70">
              {
                lang === 'ptbr'
                  ? 'Toda tecnologia listada foi utilizada em ambientes de produção reais processando milhões de transações.'
                  : 'Every technology listed has been used in real production environments processing millions of transactions.'
              }
            </p>
          </div>
        </div>
        <div class="card bg-base-200">
          <div class="card-body items-center text-center">
            <div class="mb-2 text-4xl">🏆</div>
            <h3 class="card-title text-lg">
              {lang === 'ptbr' ? 'Profissionais Certificados' : 'Certified Professionals'}
            </h3>
            <p class="text-sm text-base-content/70">
              {
                lang === 'ptbr'
                  ? 'Kubestronaut, AWS Professional, Azure Expert, Oracle OCP e mais certificações de elite.'
                  : 'Kubestronaut, AWS Professional, Azure Expert, Oracle OCP, and more elite certifications.'
              }
            </p>
          </div>
        </div>
        <div class="card bg-base-200">
          <div class="card-body items-center text-center">
            <div class="mb-2 text-4xl">🔗</div>
            <h3 class="card-title text-lg">
              {lang === 'ptbr' ? 'Cobertura End-to-End' : 'End-to-End Coverage'}
            </h3>
            <p class="text-sm text-base-content/70">
              {
                lang === 'ptbr'
                  ? 'Da infraestrutura cloud ao código de aplicação, cobrimos toda a stack de entrega de software moderna.'
                  : 'From cloud infrastructure to application code, we cover the entire modern software delivery stack.'
              }
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- All Capabilities Grid -->
  <section class="bg-base-200 py-16">
    <div class="container mx-auto px-4">
      <h2 class="mb-4 text-center text-3xl font-bold">
        {lang === 'ptbr' ? 'Nossos Pilares Tecnológicos' : 'Our Technology Pillars'}
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-base-content/70">
        {
          lang === 'ptbr'
            ? 'Explore nossas capacidades detalhadas nas principais áreas tecnológicas. Cada badge representa experiência hands-on em ambientes de produção.'
            : 'Explore our detailed capabilities across key technology areas. Each badge represents hands-on experience in production environments.'
        }
      </p>
      <CapabilitiesAccordion 
        client:load
        capabilities={capabilities} 
        lang={lang as string} 
      />
    </div>
  </section>

  <!-- Certifications -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <h2 class="mb-4 text-center text-3xl font-bold">
        {lang === 'ptbr' ? 'Certificações da Equipe' : 'Team Certifications'}
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-base-content/70">
        {
          lang === 'ptbr'
            ? 'Nossa equipe possui as certificações mais exigentes da indústria, comprovando expertise técnica profunda.'
            : 'Our team holds the most demanding certifications in the industry, proving deep technical expertise.'
        }
      </p>
      <div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-3">
        {
          certifications.map((group) => (
            <div class="card bg-base-200">
              <div class="card-body">
                <h3 class="card-title text-primary">{group.category}</h3>
                <ul class="mt-2 space-y-2">
                  {group.certs.map((cert) => (
                    <li class="flex items-start gap-2">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="mt-0.5 h-5 w-5 flex-shrink-0 text-success"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      <span class="text-sm">{cert}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="bg-primary py-16 text-primary-content">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 gap-8 text-center md:grid-cols-4">
        <div>
          <div class="text-4xl font-bold md:text-5xl">500+</div>
          <div class="mt-2 text-primary-content/80">
            {lang === 'ptbr' ? 'Nodes K8s gerenciados' : 'K8s nodes managed'}
          </div>
        </div>
        <div>
          <div class="text-4xl font-bold md:text-5xl">99.99%</div>
          <div class="mt-2 text-primary-content/80">
            {lang === 'ptbr' ? 'Uptime alcançado' : 'Uptime achieved'}
          </div>
        </div>
        <div>
          <div class="text-4xl font-bold md:text-5xl">10x</div>
          <div class="mt-2 text-primary-content/80">
            {lang === 'ptbr' ? 'Aceleração de deploy' : 'Deploy acceleration'}
          </div>
        </div>
        <div>
          <div class="text-4xl font-bold md:text-5xl">60%</div>
          <div class="mt-2 text-primary-content/80">
            {lang === 'ptbr' ? 'Redução de custos' : 'Cost reduction'}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16">
    <div class="container mx-auto px-4 text-center">
      <h2 class="mb-4 text-3xl font-bold">
        {lang === 'ptbr' ? 'Precisa de Expertise Específica?' : 'Need Specific Expertise?'}
      </h2>
      <p class="mx-auto mb-8 max-w-2xl text-base-content/70">
        {
          lang === 'ptbr'
            ? 'Conte-nos sobre seu desafio técnico e vamos discutir como nossa experiência pode ajudar seu projeto.'
            : "Tell us about your technical challenge and let's discuss how our experience can help your project."
        }
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={`/${lang}/solucoes`} class="btn btn-outline">
          {lang === 'ptbr' ? 'Ver Soluções' : 'View Solutions'}
        </a>
        <a href={`/${lang}/contato`} class="btn btn-primary">
          {lang === 'ptbr' ? 'Fale Conosco' : 'Contact Us'}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
