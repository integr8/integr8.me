---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import { Badge } from '@components/common/Badge';
import { Icon } from '@components/common/Icon';

export function getStaticPaths() {
  return [{ params: { lang: 'ptbr' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const cases = await getCollection('cases');
const viewCaseLabel = lang === 'ptbr' ? 'Ver Case Completo' : 'View Full Case';

const breadcrumbs = [
  { label: lang === 'ptbr' ? 'Início' : 'Home', href: `/${lang}` },
  { label: 'Cases' },
];
---

<PageLayout
  title="Cases de Sucesso"
  description="Resultados reais que entregamos para nossos clientes"
  breadcrumbs={breadcrumbs}
>
  <div class="grid grid-cols-1 gap-8 py-12 md:grid-cols-2">
    {
      cases.map((caseItem) => (
        <a
          href={`/${lang}/cases/${caseItem.slug.split('/').pop()}`}
          class="card block bg-base-100 shadow-lg transition-shadow hover:shadow-xl"
        >
          <div class="card-body">
            <div class="mb-4 flex items-center gap-3">
              <Icon name="TrophyIcon" className="h-6 w-6 text-warning" client:load />
              {caseItem.data.industry && <Badge variant="warning">{caseItem.data.industry}</Badge>}
            </div>

            <h3 class="card-title text-xl">{caseItem.data.title}</h3>
            <p class="mb-4 text-sm text-base-content/70">{caseItem.data.client}</p>

            <div class="divider my-2" />

            <div>
              <p class="mb-2 text-sm font-semibold">O Desafio:</p>
              <p class="text-sm text-base-content/70">{caseItem.data.challenge}</p>
            </div>

            {caseItem.data.technologies && (
              <div class="mt-4 flex flex-wrap gap-2">
                {caseItem.data.technologies.slice(0, 3).map((tech: string) => (
                  <Badge key={tech} variant="primary" size="sm">
                    {tech}
                  </Badge>
                ))}
              </div>
            )}

            <div class="card-actions mt-4 justify-end">
              <span class="inline-flex items-center gap-2 font-semibold text-primary">
                {viewCaseLabel}
                <Icon name="ArrowRightIcon" className="h-4 w-4" client:load />
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</PageLayout>
