---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import { CaseCard } from '@components/content/CaseCard';

export function getStaticPaths() {
  return [{ params: { lang: 'ptbr' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const allCases = await getCollection('cases');
const cases = allCases.filter((c) => c.id.startsWith(`${lang}/`));

const breadcrumbs = [
  { label: lang === 'ptbr' ? 'Início' : 'Home', href: `/${lang}` },
  { label: 'Cases' },
];
---

<PageLayout
  title={lang === 'ptbr' ? 'Cases de Sucesso' : 'Success Stories'}
  description={lang === 'ptbr'
    ? 'Resultados reais que entregamos para nossos clientes'
    : 'Real results we deliver for our clients'}
  breadcrumbs={breadcrumbs}
>
  <div class="stagger-children grid grid-cols-1 gap-8 py-12 md:grid-cols-2">
    {
      cases.map((caseItem, idx) => (
        <CaseCard
          client:load
          title={caseItem.data.title}
          description={caseItem.data.challenge}
          client={caseItem.data.client}
          industry={caseItem.data.industry}
          technologies={caseItem.data.technologies || []}
          href={`/${lang}/cases/${caseItem.slug.split('/').pop()}`}
          lang={lang as string}
          featured={idx === 0}
          metrics={caseItem.data.metrics || []}
        />
      ))
    }
  </div>

  {
    cases.length === 0 && (
      <div class="py-24 text-center">
        <p class="text-xl text-base-content/60">
          {lang === 'ptbr' ? 'Nenhum case publicado ainda.' : 'No case studies published yet.'}
        </p>
      </div>
    )
  }
</PageLayout>
