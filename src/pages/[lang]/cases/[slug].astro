---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Badge } from '@components/common/Badge';
import { Icon } from '@components/common/Icon';
import MDXImageWrapper from '@components/content/MDXImageWrapper.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  const paths: {
    params: { lang: string; slug: string };
    props: { caseItem: CollectionEntry<'cases'> };
  }[] = [];

  const langMap: Record<string, string> = {
    ptbr: 'ptbr',
    en: 'en',
  };

  for (const caseItem of cases) {
    const [folder, ...slugParts] = caseItem.id.split('/');
    const lang = langMap[folder] || folder;
    const slug = slugParts.join('/').replace(/\.(md|mdx)$/, '');

    paths.push({
      params: { lang, slug },
      props: { caseItem },
    });
  }

  return paths;
}

interface Props {
  caseItem: CollectionEntry<'cases'>;
}

const { lang } = Astro.params;
const { caseItem } = Astro.props;

const { Content } = await render(caseItem);
---

<BaseLayout title={`${caseItem.data.title} - Cases Integr8`} description={caseItem.data.challenge}>
  <div class="container mx-auto max-w-4xl px-4 py-12">
    <!-- Breadcrumbs -->
    <div class="breadcrumbs mb-8 text-sm">
      <ul>
        <li><a href={`/${lang}`}>{lang === 'ptbr' ? 'Início' : 'Home'}</a></li>
        <li><a href={`/${lang}/cases`}>Cases</a></li>
        <li class="text-base-content/60">{caseItem.data.title}</li>
      </ul>
    </div>

    <!-- Header -->
    <header class="mb-12">
      <div class="mb-6 flex items-center gap-4">
        <Icon name="TrophyIcon" className="h-12 w-12 text-warning" client:load />
        {
          caseItem.data.industry && (
            <Badge variant="warning" size="lg">
              {caseItem.data.industry}
            </Badge>
          )
        }
      </div>

      <h1 class="mb-4 text-4xl font-bold">{caseItem.data.title}</h1>

      {
        caseItem.data.client && (
          <p class="mb-6 text-xl text-base-content/70">{caseItem.data.client}</p>
        )
      }
    </header>

    <!-- Challenge & Solution Summary -->
    <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="card bg-base-200">
        <div class="card-body">
          <h3 class="card-title text-lg">
            <Icon name="ExclamationTriangleIcon" className="h-5 w-5 text-error" client:load />
            {lang === 'ptbr' ? 'O Desafio' : 'The Challenge'}
          </h3>
          <p class="text-base-content/80">{caseItem.data.challenge}</p>
        </div>
      </div>

      {
        caseItem.data.solution && (
          <div class="card bg-base-200">
            <div class="card-body">
              <h3 class="card-title text-lg">
                <Icon name="CheckCircleIcon" className="h-5 w-5 text-success" client:load />
                {lang === 'ptbr' ? 'A Solução' : 'The Solution'}
              </h3>
              <p class="text-base-content/80">{caseItem.data.solution}</p>
            </div>
          </div>
        )
      }
    </div>

    <!-- Technologies -->
    {
      caseItem.data.technologies && (
        <div class="mb-12">
          <h3 class="mb-4 text-lg font-semibold">
            {lang === 'ptbr' ? 'Tecnologias Utilizadas' : 'Technologies Used'}
          </h3>
          <div class="flex flex-wrap gap-2">
            {caseItem.data.technologies.map((tech: string) => (
              <Badge variant="primary">{tech}</Badge>
            ))}
          </div>
        </div>
      )
    }

    <!-- Results -->
    {
      caseItem.data.results && (
        <div class="mb-12">
          <h3 class="mb-4 text-lg font-semibold">{lang === 'ptbr' ? 'Resultados' : 'Results'}</h3>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            {caseItem.data.results.map((result: { value: string; label: string }) => (
              <div class="stat rounded-lg bg-base-200">
                <div class="stat-value text-primary">{result.value}</div>
                <div class="stat-desc">{result.label}</div>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- Content -->
    <article class="prose prose-lg max-w-none">
      <Content components={{ img: MDXImageWrapper }} />
    </article>

    <!-- Back link -->
    <div class="mt-12 border-t border-base-300 pt-8">
      <a href={`/${lang}/cases`} class="btn btn-outline">
        ← {lang === 'ptbr' ? 'Voltar aos Cases' : 'Back to Cases'}
      </a>
    </div>
  </div>
</BaseLayout>
