---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import { BlogCard } from '@components/content/BlogCard';

export function getStaticPaths() {
  return [{ params: { lang: 'ptbr' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const posts = await getCollection('blog', ({ slug }) => slug.startsWith(`${lang}/`));

const breadcrumbs = [
  { label: lang === 'ptbr' ? 'Início' : 'Home', href: `/${lang}` },
  { label: 'Blog' },
];
---

<PageLayout
  title="Blog"
  description={lang === 'ptbr' ? 'Insights técnicos, boas práticas e novidades' : 'Technical insights, best practices and news'}
  breadcrumbs={breadcrumbs}
>
  <div class="grid grid-cols-1 gap-8 py-12 md:grid-cols-2 lg:grid-cols-3 stagger-children">
    {
      posts.map((post) => (
        <BlogCard
          client:load
          title={post.data.title}
          description={post.data.description}
          image={post.data.image}
          category={post.data.category}
          readTime={post.data.read_time}
          author={post.data.author}
          date={post.data.date}
          href={`/${lang}/blog/${post.slug.split('/').pop()}`}
          lang={lang as string}
        />
      ))
    }
  </div>

  {posts.length === 0 && (
    <div class="py-24 text-center">
      <p class="text-xl text-base-content/60">
        {lang === 'ptbr' ? 'Nenhum artigo publicado ainda.' : 'No articles published yet.'}
      </p>
    </div>
  )}
</PageLayout>
