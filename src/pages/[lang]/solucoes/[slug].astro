---
import { getCollection, type CollectionEntry } from 'astro:content';
import SolutionLayout from '@layouts/SolutionLayout.astro';
import { getTranslations } from '@i18n/utils';

export async function getStaticPaths() {
  const solutions = await getCollection('solutions');
  const paths: {
    params: { lang: string; slug: string };
    props: { solution: CollectionEntry<'solutions'> };
  }[] = [];

  // Map folder names to lang params
  const langMap: Record<string, string> = {
    ptbr: 'ptbr',
    en: 'en',
  };

  for (const solution of solutions) {
    const [folder, ...slugParts] = solution.id.split('/');
    const lang = langMap[folder] || folder;
    const slug = slugParts.join('/').replace(/\.(md|mdx)$/, '');

    paths.push({
      params: { lang, slug },
      props: { solution },
    });
  }

  return paths;
}

interface Props {
  solution: CollectionEntry<'solutions'>;
}

const { lang } = Astro.params;
const { solution } = Astro.props;
const t = getTranslations(lang as 'ptbr' | 'en');

const { Content } = await solution.render();
---

<SolutionLayout
  title={solution.data.title}
  description={solution.data.description}
  category={solution.data.category}
  technologies={solution.data.technologies}
  icon={solution.data.icon}
  lang={lang}
>
  <Content />
</SolutionLayout>
