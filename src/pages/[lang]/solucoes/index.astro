---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import { SolutionCard } from '@components/content/SolutionCard';

export function getStaticPaths() {
  return [{ params: { lang: 'ptbr' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const allSolutions = await getCollection('solutions');
const solutions = allSolutions.filter((s) => s.id.startsWith(`${lang}/`));

// Highlight some solutions as featured
const featuredSlugs = ['kubernetes', 'platform-engineering', 'devops-cicd'];

const breadcrumbs = [
  { label: lang === 'ptbr' ? 'Início' : 'Home', href: `/${lang}` },
  { label: lang === 'ptbr' ? 'Soluções' : 'Solutions' },
];
---

<PageLayout
  title={lang === 'ptbr' ? 'Nossas Soluções' : 'Our Solutions'}
  description={lang === 'ptbr'
    ? 'Expertise técnica para acelerar sua jornada cloud-native'
    : 'Technical expertise to accelerate your cloud-native journey'}
  breadcrumbs={breadcrumbs}
>
  <div class="stagger-children grid grid-cols-1 gap-8 py-12 md:grid-cols-2 lg:grid-cols-3">
    {
      solutions.map((solution) => {
        const slug = solution.slug.split('/').pop() || '';
        return (
          <SolutionCard
            client:load
            title={solution.data.title}
            description={solution.data.description}
            icon={solution.data.icon}
            technologies={solution.data.technologies || []}
            href={`/${lang}/solucoes/${slug}`}
            lang={lang as string}
            featured={featuredSlugs.includes(slug)}
          />
        );
      })
    }
  </div>
</PageLayout>
