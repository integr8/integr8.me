---
import PageLayout from '@layouts/PageLayout.astro';
import { Button } from '@components/common/Button';
import { Icon } from '@components/common/Icon';
import { SOCIAL_LINKS } from '@lib/constants';

export function getStaticPaths() {
  return [{ params: { lang: 'ptbr' } }, { params: { lang: 'en' } }];
}

const linkedinUsername = SOCIAL_LINKS.linkedin.replace('https://linkedin.com/company/', '');
const githubUsername = SOCIAL_LINKS.github.replace('https://github.com/', '');
---

<PageLayout title="Contato" description="Entre em contato com a Integr8 para discutir seu projeto">
  <div class="mx-auto grid max-w-4xl grid-cols-1 gap-12 py-12 md:grid-cols-2">
    <!-- Contact Form -->
    <div>
      <h2 class="mb-6 text-2xl font-bold">Envie sua mensagem</h2>
      <form class="space-y-4" action="#">
        <div class="form-control">
          <label class="label">
            <span class="label-text flex items-center gap-2">
              <Icon name="UserIcon" className="h-4 w-4" client:load />
              Nome
            </span>
          </label>
          <input type="text" placeholder="Seu nome" class="input input-bordered" required />
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text flex items-center gap-2">
              <Icon name="EnvelopeIcon" className="h-4 w-4" client:load />
              Email
            </span>
          </label>
          <input type="email" placeholder="seu@email.com" class="input input-bordered" required />
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text flex items-center gap-2">
              <Icon name="BuildingOfficeIcon" className="h-4 w-4" client:load />
              Empresa
            </span>
          </label>
          <input type="text" placeholder="Sua empresa" class="input input-bordered" required />
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text flex items-center gap-2">
              <Icon name="RocketLaunchIcon" className="h-4 w-4" client:load />
              Interesse
            </span>
          </label>
          <select class="select select-bordered" required>
            <option disabled selected>Selecione uma solução...</option>
            <option>Platform Engineering</option>
            <option>Kubernetes</option>
            <option>DevOps/CI-CD</option>
            <option>Cloud Architecture</option>
            <option>Outro</option>
          </select>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text flex items-center gap-2">
              <Icon name="ChatBubbleLeftRightIcon" className="h-4 w-4" client:load />
              Mensagem
            </span>
          </label>
          <textarea
            class="textarea textarea-bordered h-32"
            placeholder="Descreva seu projeto ou desafio..."
            required></textarea>
        </div>

        <Button variant="primary" size="lg" className="w-full gap-2">
          <Icon name="PaperAirplaneIcon" className="h-5 w-5" client:load />
          Enviar Mensagem
        </Button>
      </form>
    </div>

    <!-- Contact Info -->
    <div>
      <h2 class="mb-6 text-2xl font-bold">Informações de Contato</h2>

      <div class="space-y-8">
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body">
            <div class="flex items-start gap-4">
              <Icon name="EnvelopeIcon" className="mt-1 h-6 w-6 text-primary" client:load />
              <div>
                <h3 class="mb-1 font-semibold">Email</h3>
                <a href={`mailto:${SOCIAL_LINKS.email}`} class="text-primary hover:underline">
                  {SOCIAL_LINKS.email}
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-lg">
          <div class="card-body">
            <div class="flex items-start gap-4">
              <Icon name="GlobeAltIcon" className="mt-1 h-6 w-6 text-primary" client:load />
              <div>
                <h3 class="mb-1 font-semibold">LinkedIn</h3>
                <a
                  href={SOCIAL_LINKS.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline"
                >
                  linkedin.com/company/{linkedinUsername}
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-lg">
          <div class="card-body">
            <div class="flex items-start gap-4">
              <Icon name="CodeBracketIcon" className="mt-1 h-6 w-6 text-primary" client:load />
              <div>
                <h3 class="mb-1 font-semibold">GitHub</h3>
                <a
                  href={SOCIAL_LINKS.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline"
                >
                  github.com/{githubUsername}
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="alert alert-info">
          <Icon name="InformationCircleIcon" className="h-5 w-5" client:load />
          <span>Respondemos em até 24h úteis</span>
        </div>
      </div>
    </div>
  </div>
</PageLayout>
