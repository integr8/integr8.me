---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from '@components/common/Icon';

const lang = 'ptbr';
---

<BaseLayout>
  <div class="min-h-screen flex flex-col items-center justify-center bg-base-100">
    <div class="text-center">
      <div class="mb-8">
        <Icon name="ExclamationTriangleIcon" className="h-24 w-24 text-error mx-auto" client:load />
      </div>
      <h1 class="text-5xl font-bold mb-4">404</h1>
      <h2 class="text-2xl font-semibold mb-4">Página não encontrada</h2>
      <p class="text-base-content/70 mb-8 max-w-md mx-auto">
        A página que você procura não existe ou foi movida. Verifique a URL e tente novamente.
      </p>
      <a href={`/${lang}/`} class="btn btn-primary gap-2">
        <Icon name="ArrowLeftIcon" className="h-5 w-5" client:load />
        Voltar para o início
      </a>
    </div>
  </div>
</BaseLayout>
